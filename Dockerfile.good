# Hardened version: a small static web server that runs as an unprivileged user.
FROM python:3.12-slim

WORKDIR /app

# COPY only what the app needs (see .dockerignore)
COPY site/ ./site/

# Numeric UID: resolvable on any host, never root
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser
USER 10001

EXPOSE 8080

# JSON form, no shell. Uses Python, which is already in the image, instead of curl.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/', timeout=3)"]

CMD ["python", "-m", "http.server", "8080", "--directory", "site"]
